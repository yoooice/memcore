{
  "name": "memcore-memory",
  "version": "0.2.0",
  "description": "本地长期记忆库：会检索、会反问、会自我纠错的记忆层，可接任何模型（MCP / HTTP / CLI），零依赖。",
  "type": "module",
  "bin": {
    "memcore": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "mcp.mjs",
    "server.mjs",
    "lib/",
    "ui/",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "start": "node server.mjs",
    "mcp": "node mcp.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "memory",
    "mcp",
    "llm",
    "agent",
    "bm25",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoooice/memcore.git"
  },
  "homepage": "https://github.com/yoooice/memcore#readme",
  "bugs": {
    "url": "https://github.com/yoooice/memcore/issues"
  },
  "license": "MIT"
}
